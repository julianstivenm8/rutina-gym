# Local: abrir la app desde esta misma URL.
BETTER_AUTH_URL=http://localhost:3000

# Generar con: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=

# Connection string de Neon, con sslmode=require.
DATABASE_URL=

# Cliente OAuth de Google de tipo "Aplicación web".
# Callback local: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# URL de la API de datos obtenida desde NEON
DATA_API_URL=

# URL de la API de BetterAuth obtenida desde NEON
AUTH_URL=

# URL de los JWKS de BetterAuth obtenida desde NEON
JWKS_URL=