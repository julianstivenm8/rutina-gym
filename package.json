{
  "name": "weekly-routine",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:auth": "node --env-file-if-exists=.env.local --experimental-strip-types --test tests/auth-flow.test.ts",
    "auth:check": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/check-auth-environment.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test:routines": "node --env-file-if-exists=.env.local --experimental-strip-types --test tests/routines.integration.test.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.15",
    "@hookform/resolvers": "^7.0.2",
    "@neondatabase/serverless": "^1.1.0",
    "@radix-ui/react-slot": "^1.3.3",
    "better-auth": "1.7.15",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.67.0",
    "next": "^16.0.0",
    "radix-ui": "^1.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.91.0",
    "server-only": "0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@next/env": "^16.4.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "drizzle-kit": "^0.31.11",
    "postcss": "^8.5.23",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0"
  },
  "type": "module",
  "packageManager": "npm@11.12.1"
}
